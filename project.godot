; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Scribe of Eras"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://bjisv1wh7436x"

[autoload]

Registry="*res://autoloads/registry.gd"
SaveManager="*res://autoloads/save_manager.gd"
AudioManager="*res://autoloads/audio_manager.gd"
MusicController="*uid://r5t485lr3p7t"
MusicDirector="*res://systems/music_director.gd"

[clean_copy_examples]

examples_paths=Array[String](["res://addons/maaacks_menus_template/examples/"])
copy_path="res://"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-resource-database/plugin.cfg", "res://addons/maaacks_menus_template/plugin.cfg", "res://addons/maaacks_music_controller/plugin.cfg", "res://addons/plugin_updater/plugin.cfg", "res://addons/save_value_viewer/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_menus_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_menus_template/base/translations/menus_translations.fr.translation", "res://addons/maaacks_menus_template/base/translations/menus_translations.zh_CN.translation", "res://addons/maaacks_menus_template/base/translations/menus_translations.zh_TW.translation")

[maaacks_menus_template]

disable_install_wizard=true
main_menu_scene_path="res://scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://main.tscn"
ending_scene_path="res://scenes/end_credits/end_credits.tscn"
copy_path="res://"

[maaacks_music_controller]

disable_install_audio_busses=true

[plugin_updater]

plugins={
"res://addons/maaacks_menus_template/": "https://github.com/Maaack/Godot-Menus-Template",
"res://addons/maaacks_music_controller/": "https://github.com/Maaack/Godot-Music-Controller",
"res://addons/plugin_updater/": "https://github.com/Maaack/Godot-Plugin-Updater"
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
