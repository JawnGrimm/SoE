[gd_resource type="Resource" script_class="EventTemplate" load_steps=31 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]
[ext_resource type="Script" path="res://data/definitions/event_condition.gd" id="4"]

[sub_resource type="Resource" id="ConditionOffice"]
script = ExtResource("4")
condition_type = &"in_office"
target = "actor"
parameters = {"office_id": &"apprentice_scribe"}

[sub_resource type="Resource" id="ConditionForm"]
script = ExtResource("4")
condition_type = &"has_pending_form"
target = "actor"
parameters = {"form_type": &"pension_roll"}

[sub_resource type="Resource" id="ConditionSowing"]
script = ExtResource("4")
condition_type = &"period_in_range"
target = "actor"
parameters = {"min": 3, "max": 3}

[sub_resource type="Resource" id="FxOpinionShuruppak1"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"shuruppak_ilu", "other": &"player_apprentice", "amount": 5, "reason": "Certified the ditch crew and denied the unlawful grain transfer"}

[sub_resource type="Resource" id="FxOpinionUrNanna1"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"ur_nanna", "other": &"player_apprentice", "amount": 3, "reason": "Kept household grain separate from the labor roll"}

[sub_resource type="Resource" id="FxLaw1"]
script = ExtResource("3")
effect_type = &"gain_skill_xp"
parameters = {"skill": &"law", "amount": 20}

[sub_resource type="Resource" id="FxCanal1"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"canal_progress", "amount": 5, "scope": "world"}

[sub_resource type="Resource" id="FxLabor1"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"labor", "amount": 5, "scope": "world"}

[sub_resource type="Resource" id="FxMemory1"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"labor_tally_certified", "text": "Certified Lu-kala's 22 ditchers; barred unlawful claim on weaver grain.", "involved": [&"enlil_kisu", &"shuruppak_ilu", &"ur_nanna"]}

[sub_resource type="Resource" id="FxResolve1"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"pension_roll", "disposition": "crew_cleared_transfer_denied"}

[sub_resource type="Resource" id="FxOpinionShuruppak2"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"shuruppak_ilu", "other": &"player_apprentice", "amount": -10, "reason": "Conflated the labor tally with the weaver grain roll"}

[sub_resource type="Resource" id="FxOpinionUrNanna2"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"ur_nanna", "other": &"player_apprentice", "amount": -6, "reason": "Granted an unsupported barley transfer"}

[sub_resource type="Resource" id="FxBarley2"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": -8, "scope": "world"}

[sub_resource type="Resource" id="FxCanal2"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"canal_progress", "amount": 10, "scope": "world"}

[sub_resource type="Resource" id="FxPliable2"]
script = ExtResource("3")
effect_type = &"add_trait"
parameters = {"trait_id": &"pliable"}

[sub_resource type="Resource" id="FxShortfall2"]
script = ExtResource("3")
effect_type = &"set_flag"
parameters = {"flag": &"weaver_ration_shortfall", "scope": "world", "periods": 3}

[sub_resource type="Resource" id="FxResolve2"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"pension_roll", "disposition": "illicit_composite_transfer"}

[sub_resource type="Resource" id="FxOpinionLuNanshe3"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"lu_nanshe", "other": &"player_apprentice", "amount": 4, "reason": "Impounded the disputed tablets for inquest"}

[sub_resource type="Resource" id="FxOpinionShuruppak3"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"shuruppak_ilu", "other": &"player_apprentice", "amount": -2, "reason": "Escalated the disputed labor and grain records"}

[sub_resource type="Resource" id="FxCanal3"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"canal_progress", "amount": -5, "scope": "world"}

[sub_resource type="Resource" id="FxSevere3"]
script = ExtResource("3")
effect_type = &"add_trait"
parameters = {"trait_id": &"severe"}

[sub_resource type="Resource" id="FxCongestion3"]
script = ExtResource("3")
effect_type = &"set_flag"
parameters = {"flag": &"court_congestion", "scope": "world", "periods": 2}

[sub_resource type="Resource" id="FxResolve3"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"pension_roll", "disposition": "impounded_for_inquest"}

[sub_resource type="Resource" id="OutcomeCertify"]
script = ExtResource("2")
label = "Certify crew count; uphold gate separation"
title_override = "THE CREW IS CERTIFIED"
description_override = "The ditch tally is certified. The labor claim stands, but the weaver grain roll cannot be transferred to it."
effects = Array[ExtResource("3")]([SubResource("FxOpinionShuruppak1"), SubResource("FxOpinionUrNanna1"), SubResource("FxLaw1"), SubResource("FxCanal1"), SubResource("FxLabor1"), SubResource("FxMemory1"), SubResource("FxResolve1")])

[sub_resource type="Resource" id="OutcomeConflate"]
script = ExtResource("2")
label = "Conflate the rolls; grant double barley to workers"
title_override = "THE ROLLS ARE CONFLATED"
description_override = "The labor and weaver rolls are combined. Barley is transferred against the joined count, leaving a shortfall in the weaving-house ration."
effects = Array[ExtResource("3")]([SubResource("FxOpinionShuruppak2"), SubResource("FxOpinionUrNanna2"), SubResource("FxBarley2"), SubResource("FxCanal2"), SubResource("FxPliable2"), SubResource("FxShortfall2"), SubResource("FxResolve2")])

[sub_resource type="Resource" id="OutcomeImpound"]
script = ExtResource("2")
label = "Impound tablets; report false claim to Lu-Nanshe"
title_override = "THE TABLETS ARE IMPOUNDED"
description_override = "The disputed tablets are held for Lu-Nanshe's inquest. The transfer stops, and the canal work loses time while the records are examined."
effects = Array[ExtResource("3")]([SubResource("FxOpinionLuNanshe3"), SubResource("FxOpinionShuruppak3"), SubResource("FxCanal3"), SubResource("FxSevere3"), SubResource("FxCongestion3"), SubResource("FxResolve3")])

[resource]
script = ExtResource("1")
id = &"case_12_labor_tally"
title = "The Labor Tally"
description = "In Sowing, Lu-kala's tally records three ditch shifts and twenty-two workers. The North Weaving House roll also marks double barley for twenty-two. Shuruppak-ilu warns that a labor tablet and a household grain roll cannot be made into one account simply because the same number appears on both."
era_tags = Array[StringName]([&"uruk"])
weight = 12.0
cooldown_years = 1
conditions = Array[ExtResource("4")]([SubResource("ConditionOffice"), SubResource("ConditionForm"), SubResource("ConditionSowing")])
evidence_left_title = "DITCH WORKSITE  /  LABOR TALLY"
evidence_right_title = "NORTH WEAVING HOUSE  /  BARLEY ROLL"
evidence_left_speaker = "LU-KALA"
evidence_right_speaker = "SHURUPPAK-ILU"
evidence_left_quote = "Three shifts. Twenty-two workers. Their days are entered here."
evidence_right_quote = "The same twenty-two appears on a household grain roll. Tablets and houses cannot transfer barley between accounts."
evidence_left_portrait = &""
evidence_right_portrait = &"shuruppak_ilu"
records = Array[Dictionary]([{"label": "DITCH TALLY", "value": "3 shifts · 22 workers", "note": "Labor count entered by Lu-kala."}, {"label": "WEAVING HOUSE ROLL", "value": "22 marked for double barley", "note": "Household grain account; not a labor tally."}])
outcomes = Array[ExtResource("2")]([SubResource("OutcomeCertify"), SubResource("OutcomeConflate"), SubResource("OutcomeImpound")])
