[gd_resource type="Resource" script_class="EventTemplate" load_steps=15 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]

[sub_resource type="Resource" id="fx_1"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"utu_mansum", "other": &"player_apprentice", "amount": 3, "reason": "Damage noted before custody"}

[sub_resource type="Resource" id="fx_2"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"enlil_kisu", "other": &"player_apprentice", "amount": 1, "reason": "Crew cleared of deliberate theft"}

[sub_resource type="Resource" id="fx_3"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"clay_reeds", "amount": -1, "scope": "world"}

[sub_resource type="Resource" id="fx_4"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"sealed_vessel_received", "text": "Received 4 oil jars and 6 linens; quarantined one cracked jar.", "involved": [&"utu_mansum", &"enlil_kisu"]}

[sub_resource type="Resource" id="fx_5"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"consignment_receipt", "disposition": "quarantine_cracked_vessel"}

[sub_resource type="Resource" id="fx_6"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"enlil_kisu", "other": &"player_apprentice", "amount": -10, "reason": "Forced crew to sleep in the yard"}

[sub_resource type="Resource" id="fx_7"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"utu_mansum", "other": &"player_apprentice", "amount": 5, "reason": "Rigid protection of storehouse gates"}

[sub_resource type="Resource" id="fx_8"]
script = ExtResource("3")
effect_type = &"set_flag"
parameters = {"flag": &"yard_congestion", "scope": "world", "periods": 2}

[sub_resource type="Resource" id="fx_9"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"consignment_receipt", "disposition": "rejected_at_threshold"}

[sub_resource type="Resource" id="outcome_1"]
script = ExtResource("2")
label = "Mark vessel received damaged; record seal broken prior to entry"
title_override = "THE CRACK IS ENTERED"
description_override = "You note the crack in the clay collar and accept the custody of four vessels, isolating the damaged jar for temple inspection. Utu-mansum records the receipt. Enlil-kisu's crew is cleared to disperse."
effects = Array[ExtResource("3")]([SubResource("fx_1"), SubResource("fx_2"), SubResource("fx_3"), SubResource("fx_4"), SubResource("fx_5")])

[sub_resource type="Resource" id="outcome_2"]
script = ExtResource("2")
label = "Reject the cracked vessel; turn the load away at the gate"
title_override = "THE LOAD IS TURNED AWAY"
description_override = "You refuse the cracked jar. The entire consignment is halted at the threshold. Enlil-kisu's men must guard the goods in the dusty yard overnight without beer or bread rations."
effects = Array[ExtResource("3")]([SubResource("fx_6"), SubResource("fx_7"), SubResource("fx_8"), SubResource("fx_9")])

[resource]
script = ExtResource("1")
id = &"case_01_sealed_vessel"
title = "The Sealed Vessel and the Textile Bundles"
description = "A consignment of oil jars and linen bundles sits on the reed mat as the receiving court prepares to close. The carriers are gray with dust. On the clay tag pierced to the bundle, four jars and six cloths are marked. On the mat sit four jars, but the seal on the smallest vessel is cracked and smeared with dry mud. Utu-mansum will not touch the cracked jar without an apprentice's mark."
era_tags = Array[StringName]([&"uruk"])
weight = 1.0
outcomes = Array[ExtResource("2")]([SubResource("outcome_1"), SubResource("outcome_2")])
