[gd_resource type="Resource" script_class="EventTemplate" load_steps=11 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_condition.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="4"]

[sub_resource type="Resource" id="ConditionScandal"]
script = ExtResource("2")
condition_type = &"flag_set"
parameters = {"flag": &"grain_scandal", "scope": "world"}

[sub_resource type="Resource" id="ConditionInquiry"]
script = ExtResource("2")
condition_type = &"has_pending_form"
parameters = {"form_type": &"inquiry"}

[sub_resource type="Resource" id="EffectAcceptMemory"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"origin_reply_accepted", "text": "I accepted the origin-side reply as sufficient to close the inquiry, though it did not establish who caused the original difference.", "involved": []}

[sub_resource type="Resource" id="EffectMagistrateMemory"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"magistrate_review_requested", "text": "I sent the origin-side reply to the magistrate for further review.", "involved": []}

[sub_resource type="Resource" id="EffectResolveAccept"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"inquiry", "disposition": "reply_accepted"}

[sub_resource type="Resource" id="EffectResolveMagistrate"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"inquiry", "disposition": "referred_to_magistrate"}

[sub_resource type="Resource" id="OutcomeAccept"]
script = ExtResource("4")
label = "Accept the reply and close the inquiry"
weight = 1.0
title_override = "The reply is entered into the archive."
description_override = "The origin office has supplied a dispatch copy, but no independent loading witness. The inquiry is closed with the discrepancy still unresolved."
effects = Array[ExtResource("3")]([SubResource("EffectAcceptMemory"), SubResource("EffectResolveAccept")])

[sub_resource type="Resource" id="OutcomeMagistrate"]
script = ExtResource("4")
label = "Refer the reply to the magistrate"
weight = 1.0
title_override = "The magistrate receives the file."
description_override = "The reply is added to the record and referred for review. The inquiry is closed at this desk; responsibility remains unassigned."
effects = Array[ExtResource("3")]([SubResource("EffectMagistrateMemory"), SubResource("EffectResolveMagistrate")])

[resource]
script = ExtResource("1")
id = &"origin_side_reply"
title = "The Origin-Side Reply"
description = "A reply has arrived from the origin office. It repeats the dispatch figure but supplies no independent witness to loading. The magistrate's clerk asks whether the file can now be closed."
weight = 1.0
once_per_world = true
conditions = Array[ExtResource("2")]([SubResource("ConditionScandal"), SubResource("ConditionInquiry")])
outcomes = Array[ExtResource("4")]([SubResource("OutcomeAccept"), SubResource("OutcomeMagistrate")])
