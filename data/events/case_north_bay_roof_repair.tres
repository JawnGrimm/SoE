[gd_resource type="Resource" script_class="EventTemplate" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]
[ext_resource type="Script" path="res://data/definitions/event_condition.gd" id="4"]

[sub_resource type="Resource" id="ConditionRepairForm"]
script = ExtResource("4")
condition_type = &"has_pending_form"
target = "actor"
parameters = {"form_type": &"north_bay_roof_repair"}

[sub_resource type="Resource" id="ConditionLabor"]
script = ExtResource("4")
condition_type = &"resource_compare"
target = "actor"
parameters = {"resource": &"labor", "comparison": ">=", "value": 3, "scope": "institution", "institution_id": &"eanna_household"}

[sub_resource type="Resource" id="EffectLabor"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"labor", "amount": -3, "scope": "institution"}

[sub_resource type="Resource" id="EffectRepair"]
script = ExtResource("3")
effect_type = &"repair_hazard"
parameters = {"place_id": &"north_bay", "hazard_id": &"roof_leak"}

[sub_resource type="Resource" id="EffectCloseRepairForm"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"north_bay_roof_repair", "disposition": "roof_repaired"}

[sub_resource type="Resource" id="EffectRepairMemory"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"north_bay_roof_repaired", "text": "I authorized three labor units to repair the North-Bay roof. The water loss stopped.", "involved": [&"ur_nanna"]}

[sub_resource type="Resource" id="OutcomeRepair"]
script = ExtResource("2")
label = "Authorize three labor units and repair the roof"
title_override = "THE ROOF IS REPAIRED"
description_override = "Three labor units are assigned to the damaged beam and roof covering. The repair is entered in the storehouse docket; the leak has stopped."
effects = Array[ExtResource("3")]([SubResource("EffectLabor"), SubResource("EffectRepair"), SubResource("EffectCloseRepairForm"), SubResource("EffectRepairMemory")])

[resource]
script = ExtResource("1")
id = &"case_north_bay_roof_repair"
title = "North-Bay Roof Repair"
description = "Ur-Nanna's repair docket is on the desk. The North-Bay roof has been inspected, and the leak has spoiled several measures of barley. Three labor units are available for the repair. The work can now be authorized and entered."
era_tags = Array[StringName]([&"uruk"])
weight = 20.0
once_per_world = true
conditions = Array[ExtResource("4")]([SubResource("ConditionRepairForm"), SubResource("ConditionLabor")])
evidence_left_title = "NORTH-BAY  /  REPAIR ORDER"
evidence_right_title = "STOREHOUSE  /  LABOR AVAILABLE"
evidence_left_speaker = "UR-NANNA"
evidence_right_speaker = "WORK CREW"
evidence_left_quote = "The leak is recorded. Authorize the work before more barley is lost."
evidence_right_quote = "Three labor units can be assigned to the damaged roof."
evidence_left_portrait = &"ur_nanna"
evidence_right_portrait = &""
records = Array[Dictionary]([{"label": "REPAIR ORDER", "value": "North-Bay roof leak", "note": "Physical inspection filed; repair still outstanding."}, {"label": "LABOR", "value": "3 labor units required", "note": "Labor is consumed when the repair is authorized."}])
outcomes = Array[ExtResource("2")]([SubResource("OutcomeRepair")])
