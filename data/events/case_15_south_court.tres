[gd_resource type="Resource" script_class="EventTemplate" load_steps=32 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]
[ext_resource type="Script" path="res://data/definitions/event_condition.gd" id="4"]


[sub_resource type="Resource" id="condition_1"]
script = ExtResource("4")
condition_type = &"has_pending_form"
target = "actor"
parameters = {"form_type": &"grain_levy"}


[sub_resource type="Resource" id="fx_1"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"utu_mansum", "other": &"player_apprentice", "amount": 2, "reason": "Fair recording of threshold count"}

[sub_resource type="Resource" id="fx_2"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"enlil_kisu", "other": &"player_apprentice", "amount": 2, "reason": "Crew not blamed for transit loss"}

[sub_resource type="Resource" id="fx_3"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"shuruppak_ilu", "other": &"player_apprentice", "amount": 5, "reason": "Honest report of limits"}

[sub_resource type="Resource" id="fx_4"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": 23, "scope": "world"}

[sub_resource type="Resource" id="fx_5"]
script = ExtResource("3")
effect_type = &"gain_skill_xp"
parameters = {"skill": &"law", "amount": 15}

[sub_resource type="Resource" id="fx_6"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"south_court_discrepancy", "text": "Recorded 23 measures of barley into the South Court; preserved the 1-measure discrepancy without accusation.", "involved": [&"utu_mansum", &"enlil_kisu"]}

[sub_resource type="Resource" id="fx_7"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"grain_levy", "disposition": "custody_accepted_with_discrepancy", "assessment": "Discrepancy unattributed; origin recount pending"}

[sub_resource type="Resource" id="fx_8"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"enlil_kisu", "other": &"player_apprentice", "amount": 8, "reason": "Vouched for carrier tally"}

[sub_resource type="Resource" id="fx_9"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"utu_mansum", "other": &"player_apprentice", "amount": -12, "reason": "Overrode threshold tally"}

[sub_resource type="Resource" id="fx_10"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"shuruppak_ilu", "other": &"player_apprentice", "amount": -5, "reason": "Falsified count to appease carrier"}

[sub_resource type="Resource" id="fx_11"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": 23, "scope": "world"}

[sub_resource type="Resource" id="fx_12"]
script = ExtResource("3")
effect_type = &"set_flag"
parameters = {"flag": &"phantom_barley_measure", "scope": "world", "years": 1}

[sub_resource type="Resource" id="fx_13"]
script = ExtResource("3")
effect_type = &"add_trait"
parameters = {"trait_id": &"pliable"}

[sub_resource type="Resource" id="fx_14"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"utu_mansum", "other": &"player_apprentice", "amount": 6, "reason": "Upheld threshold authority"}

[sub_resource type="Resource" id="fx_15"]
script = ExtResource("3")
effect_type = &"change_opinion"
parameters = {"subject": &"enlil_kisu", "other": &"player_apprentice", "amount": -15, "reason": "Docked crew rations without proof"}

[sub_resource type="Resource" id="fx_16"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": 23, "scope": "world"}

[sub_resource type="Resource" id="fx_17"]
script = ExtResource("3")
effect_type = &"set_flag"
parameters = {"flag": &"carrier_distrust", "scope": "world", "years": 2}

[sub_resource type="Resource" id="fx_18"]
script = ExtResource("3")
effect_type = &"add_trait"
parameters = {"trait_id": &"severe"}

[sub_resource type="Resource" id="fx_19"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"grain_levy", "disposition": "accepted_with_carrier_penalty"}


[sub_resource type="Resource" id="fx_20"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"canal_progress", "amount": 5, "scope": "world"}

[sub_resource type="Resource" id="fx_21"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"canal_progress", "amount": 0, "scope": "world"}

[sub_resource type="Resource" id="fx_22"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"canal_progress", "amount": 0, "scope": "world"}

[sub_resource type="Resource" id="fx_23"]
script = ExtResource("3")
effect_type = &"set_flag"
parameters = {"flag": &"canal_crew_slowdown", "scope": "world", "periods": 2}

[sub_resource type="Resource" id="outcome_1"]
script = ExtResource("2")
label = "Score Tally as 23 (Discrepancy Unassigned)"
title_override = "THE COUNT IS SET DOWN"
description_override = "Neither man blamed. The single missing measure is noted as unassigned transit loss. Utu-mansum grunts and accepts custody of 23. Enlil-kisu sighs and releases his crew to the bread-line."
effects = Array[ExtResource("3")]([SubResource("fx_1"), SubResource("fx_2"), SubResource("fx_3"), SubResource("fx_4"), SubResource("fx_5"), SubResource("fx_6"), SubResource("fx_7"), SubResource("fx_20")])


[sub_resource type="Resource" id="outcome_2"]
script = ExtResource("2")
label = "Press Seal as 24"
title_override = "THE TABLET SAYS TWENTY-FOUR"
description_override = "You smooth wet mud over Utu-mansum's mark and press the storehouse seal for 24. The books balance with the boatmen's dispatch. The granary holds one measure less than the clay claims."
effects = Array[ExtResource("3")]([SubResource("fx_8"), SubResource("fx_9"), SubResource("fx_10"), SubResource("fx_11"), SubResource("fx_12"), SubResource("fx_13"), SubResource("fx_21")])


[sub_resource type="Resource" id="outcome_3"]
script = ExtResource("2")
label = "Break Tablet; Re-mark Shortage"
title_override = "THE CREW BEARS THE SHORT COUNT"
description_override = "You mark the 23 measures and score a debt mark against Enlil-kisu's crew. Utu-mansum nods and affixes his seal. Enlil-kisu spits in the dust and turns to tell his crew their barley ration is docked."
effects = Array[ExtResource("3")]([SubResource("fx_14"), SubResource("fx_15"), SubResource("fx_16"), SubResource("fx_17"), SubResource("fx_18"), SubResource("fx_19"), SubResource("fx_22"), SubResource("fx_23")])


[resource]
script = ExtResource("1")
id = &"case_15_south_court"
title = "The South Court Delivery"
description = "The dispatch tablet in Enlil-kisu's name says twenty-four measures of barley left the threshing floor. Utu-mansum counted twenty-three crossing the storehouse threshold. Neither watched the loading. Neither watched the unloading. Enlil-kisu waits by the doorway with his hungry boatmen. Utu-mansum stands by the scale and will not restamp his tally."
era_tags = Array[StringName]([&"uruk"])
weight = 1.0
once_per_world = false
conditions = Array[ExtResource("4")]([SubResource("condition_1")])
outcomes = Array[ExtResource("2")]([SubResource("outcome_1"), SubResource("outcome_2"), SubResource("outcome_3")])
