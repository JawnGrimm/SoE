[gd_resource type="Resource" script_class="EventTemplate" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]
[ext_resource type="Script" path="res://data/definitions/event_condition.gd" id="4"]

[sub_resource type="Resource" id="ConditionForm"]
script = ExtResource("4")
condition_type = &"has_pending_form"
target = "actor"
parameters = {"form_type": &"held_barley"}

[sub_resource type="Resource" id="EffectRelease"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": -6, "scope": "world"}

[sub_resource type="Resource" id="EffectReleaseMemory"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"held_barley_released", "text": "I released six measures of held barley against the household claim.", "involved": [&"ama_edin", &"ur_nanna"]}

[sub_resource type="Resource" id="EffectRetain"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": 6, "scope": "world"}

[sub_resource type="Resource" id="EffectRetainMemory"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"held_barley_retained", "text": "I kept six measures of barley under storehouse hold until the claim is settled.", "involved": [&"ama_edin", &"ur_nanna"]}

[sub_resource type="Resource" id="OutcomeRelease"]
script = ExtResource("2")
label = "Release the held barley to the household"
title_override = "THE BARLEY IS RELEASED"
description_override = "The household receives the held measures. The storehouse must account for the release in its next balance."
effects = Array[ExtResource("3")]([SubResource("EffectRelease"), SubResource("EffectReleaseMemory")])

[sub_resource type="Resource" id="OutcomeRetain"]
script = ExtResource("2")
label = "Keep the barley under storehouse hold"
title_override = "THE HOLD REMAINS"
description_override = "The measures remain in storage pending a settled claim. The household leaves without the barley."
effects = Array[ExtResource("3")]([SubResource("EffectRetain"), SubResource("EffectRetainMemory")])

[resource]
script = ExtResource("1")
id = &"case_14_held_barley"
title = "The Held Barley"
description = "Ama-edin's household has been denied six measures of barley pending a storehouse review. Ur-Nanna says the hold protects the reserve. The household says the measures were already assigned. The barley is present; the question is whose record governs its release."
era_tags = Array[StringName]([&"uruk"])
weight = 8.0
cooldown_years = 1
conditions = Array[ExtResource("4")]([SubResource("ConditionForm")])
evidence_left_title = "HOUSEHOLD  /  CLAIM"
evidence_right_title = "STOREHOUSE  /  HOLD"
evidence_left_speaker = "AMA-EDIN"
evidence_right_speaker = "UR-NANNA"
evidence_left_quote = "Those measures were entered for our household before the hold was placed."
evidence_right_quote = "The reserve was short. I held the barley until the account could be checked."
evidence_left_portrait = &"ama_edin"
evidence_right_portrait = &"ur_nanna"
records = Array[Dictionary]([{"label": "HOUSEHOLD CLAIM", "value": "6 measures barley assigned", "note": "Claim refers to the prior allocation."}, {"label": "STOREHOUSE HOLD", "value": "6 measures retained", "note": "No release mark appears on the current tablet."}])
outcomes = Array[ExtResource("2")]([SubResource("OutcomeRelease"), SubResource("OutcomeRetain")])
