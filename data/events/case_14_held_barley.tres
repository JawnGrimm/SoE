[gd_resource type="Resource" script_class="EventTemplate" load_steps=19 format=3]

[ext_resource type="Script" path="res://data/definitions/event_template.gd" id="1"]
[ext_resource type="Script" path="res://data/definitions/event_outcome.gd" id="2"]
[ext_resource type="Script" path="res://data/definitions/event_effect.gd" id="3"]
[ext_resource type="Script" path="res://data/definitions/event_condition.gd" id="4"]

[sub_resource type="Resource" id="ConditionForm"]
script = ExtResource("4")
condition_type = &"has_pending_form"
target = "actor"
parameters = {"form_type": &"held_barley"}

[sub_resource type="Resource" id="ConditionHarvest"]
script = ExtResource("4")
condition_type = &"period_in_range"
target = "actor"
parameters = {"min": 6, "max": 6}

[sub_resource type="Resource" id="FxReleaseFive"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": -5, "scope": "world"}

[sub_resource type="Resource" id="FxMemoryFive"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"held_barley_partial_release", "text": "Released five dry jars of Bay 4 barley and quarantined the two wet-stained jars.", "involved": [&"ur_nanna", &"nin_kasi"]}

[sub_resource type="Resource" id="FxResolveFive"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"held_barley", "disposition": "five_released_two_quarantined"}

[sub_resource type="Resource" id="FxReleaseAll"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": -7, "scope": "world"}

[sub_resource type="Resource" id="FxMemoryAll"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"held_barley_all_released", "text": "Released all seven Bay 4 jars, including the two wet-stained jars.", "involved": [&"ur_nanna", &"nin_kasi"]}

[sub_resource type="Resource" id="FxResolveAll"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"held_barley", "disposition": "all_seven_released"}

[sub_resource type="Resource" id="FxCondemn"]
script = ExtResource("3")
effect_type = &"modify_resource"
parameters = {"resource": &"barley", "amount": -7, "scope": "world"}

[sub_resource type="Resource" id="FxMemoryCondemn"]
script = ExtResource("3")
effect_type = &"add_memory"
parameters = {"memory_id": &"held_barley_condemned", "text": "Condemned and broke the seals on all seven Bay 4 jars.", "involved": [&"ur_nanna", &"nin_kasi"]}

[sub_resource type="Resource" id="FxResolveCondemn"]
script = ExtResource("3")
effect_type = &"resolve_form"
parameters = {"form_type": &"held_barley", "disposition": "all_seals_broken"}

[sub_resource type="Resource" id="OutcomeFive"]
script = ExtResource("2")
label = "Release five dry jars; quarantine two wet-stained"
title_override = "FIVE JARS ARE RELEASED"
description_override = "Five dry jars are released for prime seed-corn. The two wet-stained jars remain sealed under quarantine for inspection."
effects = Array[ExtResource("3")]([SubResource("FxReleaseFive"), SubResource("FxMemoryFive"), SubResource("FxResolveFive")])

[sub_resource type="Resource" id="OutcomeAll"]
script = ExtResource("2")
label = "Release all seven jars to the brewer's feed"
title_override = "ALL SEVEN JARS ARE RELEASED"
description_override = "All seven jars are released as brewer's feed. The two wet-stained jars leave Bay 4 with the dry grain."
effects = Array[ExtResource("3")]([SubResource("FxReleaseAll"), SubResource("FxMemoryAll"), SubResource("FxResolveAll")])

[sub_resource type="Resource" id="OutcomeCondemn"]
script = ExtResource("2")
label = "Condemn the lot; break all seals"
title_override = "THE SEALS ARE BROKEN"
description_override = "All seven jars are condemned and their seals broken. Neither seed-corn nor brewer's feed is issued from this lot."
effects = Array[ExtResource("3")]([SubResource("FxCondemn"), SubResource("FxMemoryCondemn"), SubResource("FxResolveCondemn")])

[resource]
script = ExtResource("1")
id = &"case_14_held_barley"
title = "The Held Barley"
description = "After the storm, Ur-Nanna reports seven jars in Bay 4: five remain dry, while two are wet-stained. The rolls disagree over whether the lot is prime seed-corn or brewer's feed. Shuruppak-ilu cautions that a sealed jar cannot be judged from its outer mark alone."
era_tags = Array[StringName]([&"uruk"])
weight = 12.0
cooldown_years = 1
conditions = Array[ExtResource("4")]([SubResource("ConditionForm"), SubResource("ConditionHarvest")])
evidence_left_title = "BAY 4  /  STOREHOUSE INSPECTION"
evidence_right_title = "ROLLS  /  CLAIMS"
evidence_left_speaker = "UR-NANNA"
evidence_right_speaker = "SHURUPPAK-ILU"
evidence_left_quote = "Five jars are dry. Two are wet-stained. The lot must be accounted for before it leaves the bay."
evidence_right_quote = "The rolls name seed-corn and brewer's feed. The seal does not tell us what lies inside."
evidence_left_portrait = &"ur_nanna"
evidence_right_portrait = &"shuruppak_ilu"
records = Array[Dictionary]([{"label": "BAY 4", "value": "7 jars total · 5 dry · 2 wet-stained", "note": "Post-storm inspection."}, {"label": "STOREHOUSE ROLL", "value": "Prime seed-corn", "note": "One claim for the lot."}, {"label": "BREWER'S ROLL", "value": "Brewer's feed", "note": "Conflicting use recorded."}])
outcomes = Array[ExtResource("2")]([SubResource("OutcomeFive"), SubResource("OutcomeAll"), SubResource("OutcomeCondemn")])
